# 复制为 .env 后填写真实值；.env 已在 .gitignore 内，不会进仓库。
#     cp .env.example .env
#
# 管理密码：保护签到执行 / 配置增删改 / 查看真实 token / 运行历史 / 定时设置。
# 公网部署必须设置，且请用足够长的随机口令（建议 24 位以上）：
#     python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GYQD_ADMIN_PASSWORD=

# 反代已是 https 时设为 1 下发 HSTS。注意它会把整个域名（含该域名上其它端口的服务）
# 锁到 https，确认所有子服务都支持 https 后再打开。
GYQD_HSTS=0
