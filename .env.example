# 复制为 .env 后填写真实值；.env 已在 .gitignore 内，不会进仓库。
#     cp .env.example .env
#
# 管理密码：保护签到执行 / 配置增删改 / 查看真实 token / 运行历史 / 定时设置。
# 公网部署必须设置，且请用足够长的随机口令（建议 24 位以上）：
#     python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GYQD_ADMIN_PASSWORD=

# 私密模式：设 1 后未解锁的访客连收藏库清单都看不到（只留解锁界面）。
# 默认 0——首页本来就是设计给人直接打开的导航页。
GYQD_PRIVATE=0

# 反代已是 https 时设为 1 下发 HSTS。注意它会把整个域名（含该域名上其它端口的服务）
# 锁到 https，确认所有子服务都支持 https 后再打开。
GYQD_HSTS=0

# ---- 被自己的 HaloWebUI 嵌入（可选，两项一起用）----
# 允许哪些站点把本站嵌进 iframe：写完整的源（协议 + 主机 + 端口），多个用空格分隔。
# 不支持通配符；留空 = 只允许同源（任何外站都嵌不进来）。
#     HUB_FRAME_ANCESTORS=https://host.acedylan.us:3001
HUB_FRAME_ANCESTORS=

# 受信任嵌入方的共享密钥：HaloWebUI 的管理员打开 /hub 时免输管理密码，直接是这里的管理员会话。
# 部署时由管理员现场生成，绝不要写进任何会入库的文件；HaloWebUI 那边的同名环境变量填同一个值。
# 留空 = 功能关闭（/embed/enter 回 404）。少于 32 个字符会被忽略。
#     python3 -c "import secrets; print(secrets.token_hex(32))"
HUB_TRUSTED_EMBED_ADMIN_SECRET=
