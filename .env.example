# 复制为 .env 后填写真实值；.env 已在 .gitignore 内，不会进仓库。
#     cp .env.example .env
#
# 管理密码：保护签到执行 / 配置增删改 / 查看真实 token / 运行历史 / 定时设置。
# 公网部署必须设置，且请用足够长的随机口令（建议 24 位以上）：
#     python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GYQD_ADMIN_PASSWORD=

# 收藏库默认登录后才出现（设了管理密码即私密模式：未解锁的访客只看到解锁界面，接口也不给数据）。
# 确实要把首页当公开导航页给路人看的，设 1。（旧开关 GYQD_PRIVATE=1 仍强制私密；=0 已无作用。）
HUB_PUBLIC_LIBRARY=0

# 反代已是 https 时设为 1 下发 HSTS。注意它会把整个域名（含该域名上其它端口的服务）
# 锁到 https，确认所有子服务都支持 https 后再打开。
GYQD_HSTS=0

# ---- 「AI 聊天」标签页：把自己的 HaloWebUI 嵌进来（可选）----
# HaloWebUI 的完整源（协议 + 主机 + 端口，不带路径、不支持通配符）。留空 = 没有这个标签页。
# 入口和地址只给已解锁的人。HaloWebUI 那边的 HUB_URL 要写成本站的地址，它才允许本站嵌入。
#     HUB_CHAT_URL=https://host.acedylan.us:3001
HUB_CHAT_URL=

# 免登录（可选）：本站管理员已解锁 = HaloWebUI 已登录。部署时由管理员现场生成，绝不要写进任何会入库的文件；
# HaloWebUI 那边的同名环境变量填同一个值。留空 = 框里自己登录 HaloWebUI。少于 32 个字符会被忽略。
# 管理密码没设 / 短于 12 位 / 曾在本仓库公开历史里出现过时，不会用它替你登录 HaloWebUI（页面会说明）。
#     python3 -c "import secrets; print(secrets.token_hex(32))"
HUB_TRUSTED_EMBED_ADMIN_SECRET=

# 本站对外的源（写进票据的签发方）。通常不用配——取浏览器请求里的 Origin；反代改写了 Host / 协议时才填。
#     HUB_PUBLIC_ORIGIN=https://best.acedylan.us:5526
HUB_PUBLIC_ORIGIN=
